{
  "name": "Quick Link",
  "version": "1.0.0",
  "author": { "name": "kcontreras-csm", "url": "https://github.com/kcontreras-csm" },
  "description": "Adds a shortcut to any web page in the sidebar. Also an example of changing the sidebar and registering settings from an extension.",
  "icon": "symbol:link",
  "category": "Examples",
  "keywords": ["sidebar", "example", "settings"],
  "permissions": ["ui"],
  "background": "background.js",
  "settings": [
    { "key": "enabled", "type": "boolean", "title": "Show the link", "default": true },
    { "key": "title", "type": "string", "title": "Label", "placeholder": "Queue", "default": "Queue" },
    {
      "key": "url",
      "type": "string",
      "title": "Address",
      "description": "The page to open. It must start with https://",
      "default": "https://orgcs.lightning.force.com/lightning/o/Case/list"
    },
    {
      "key": "section",
      "type": "choice",
      "title": "Show it in",
      "options": [
        { "value": "apps", "label": "Apps sidebar" },
        { "value": "assistants", "label": "Assistants panel" }
      ],
      "default": "apps"
    }
  ]
}
