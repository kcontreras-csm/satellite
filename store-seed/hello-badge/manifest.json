{
  "name": "Hello Badge",
  "version": "1.0.0",
  "author": { "name": "kcontreras-csm", "url": "https://github.com/kcontreras-csm" },
  "description": "Shows a small badge on Salesforce pages and counts your visits. A starting point for writing your own extension.",
  "icon": "symbol:hand.wave.fill",
  "category": "Examples",
  "keywords": ["example", "starter", "badge"],
  "homepage": "https://github.com/kcontreras-csm/satellite-extensions",
  "dependencies": { "shared-utils": "^1.0.0" },
  "permissions": ["storage"],
  "matches": ["*://*.force.com/*", "*://*.salesforce.com/*"],
  "js": ["content.js"],
  "run_at": "document_idle",
  "world": "isolated"
}
